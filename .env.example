# Linker Mind Environment Variables

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================

# Database Type: 'sqlite' or 'postgresql'
# If not set, will default to sqlite
DB_TYPE=postgresql

# SQLite Database Path (used only when DB_TYPE=sqlite)
SQLITE_DB_PATH=linker_mind.db

# ===================================================================
# POSTGRESQL CONNECTION (when DB_TYPE=postgresql)
# ===================================================================

# Full PostgreSQL URL (alternative to individual settings)
# Format: postgresql://user:password@host:port/database
# or JDBC format: jdbc:postgresql://host:port/database
DATABASE_URL=jdbc:postgresql://117.72.207.52:5432/linker-mind

# Individual PostgreSQL settings (used if DATABASE_URL not set)
PGHOST=117.72.207.52
PGPORT=5432
PGDATABASE=linker-mind
PGUSER=postgres
PGPASSWORD=LinkerAI@2026

# ===================================================================
# API KEYS
# ===================================================================

# Firecrawl API (网页抓取)
# 获取地址: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=fc-your_api_key_here

# DeepSeek API (AI分析)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your_api_key_here

# Tavily API (Twitter/X 抓取)
# 获取地址: https://tavily.com/
TAVILY_API_KEY=tvly-your_api_key_here
